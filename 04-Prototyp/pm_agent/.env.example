# Copy to .env and fill in. .env is git-ignored: never commit the key.
OPENAI_API_KEY=
# The model the agents use, e.g. one your account has free usage for. No default.
PM_AGENT_MODEL=
# Only if the model asks for it. Some take function tools in chat completions only with
# "none" (the API then says: set reasoning_effort to 'none'):
# PM_AGENT_REASONING_EFFORT=none
# Only for another OpenAI-compatible endpoint:
# OPENAI_BASE_URL=
