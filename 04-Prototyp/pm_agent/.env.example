# Copy to .env and fill in. .env is git-ignored: never commit the key.
# Note: values with spaces break `uv run --env-file .env`.
OPENAI_API_KEY=
# Required for the HSBI KI:connect endpoint (or any other OpenAI-compatible endpoint; without
# it, requests go to api.openai.com and fail with 401). Comment out only when using
# api.openai.com directly (do not leave it empty).
OPENAI_BASE_URL=
# Model ID offered by the endpoint (no default in code; list IDs via OpenAI().models.list()).
PM_AGENT_MODEL=
# Optional reasoning effort for the Responses API (default: medium):
# PM_AGENT_REASONING_EFFORT=medium
# Optional KI-Lab overrides (without PM_MODEL, the lab falls back to PM_AGENT_MODEL):
# PM_MODEL=
# PM_LAB_REASONING_EFFORT=medium
